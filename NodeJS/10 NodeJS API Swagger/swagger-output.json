{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "Clientes API",
    "description": "API que permite registrar e consultar clientes mantidos em memória."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/clientes/": {
      "get": {
        "tags": [
          "Clientes"
        ],
        "summary": "Retorna a lista de clientes registrados.",
        "description": "Este endpoint retorna a lista de clientes registrados. O resultado é um array de objetos, onde cada objeto representa um cliente e possui os seguintes campos: id (inteiro), nome (string) e credito (double).",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Clientes"
        ],
        "summary": "Insere um novo cliente.",
        "description": "Este endpoint insere um novo cliente na base de dados, dados o seu nome e limite de crédito.",
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": {
                    "example": "any"
                  },
                  "credito": {
                    "example": "any"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/clientes/{id([0-9]+)}": {
      "get": {
        "tags": [
          "Clientes"
        ],
        "summary": "Retorna os dados completos de um cliente.",
        "description": "Este endpoint retorna os dados completos de um cliente (nome e crédito) dado o seu ID.",
        "parameters": [
          {
            "name": "id([0-9]+)",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/clientes/{id}": {
      "put": {
        "tags": [
          "Clientes"
        ],
        "summary": "Atualiza os dados de um cliente.",
        "description": "Este endpoint atualiza os dados de um cliente existente, dados o seu ID, novo nome e novo limite de crédito.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": {
                    "example": "any"
                  },
                  "credito": {
                    "example": "any"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Clientes"
        ],
        "summary": "Remove um cliente.",
        "description": "Este endpoint remove um cliente existente, dado o seu ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}